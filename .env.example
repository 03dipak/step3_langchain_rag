# ──────────────────────────────────────────────────────────────────────
# Step 3 — LangChain RAG  |  .env.example
# Copy to .env and fill in real values. NEVER commit your real .env.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────

# ── LLM (same Qwen as Step 2 via an OpenAI-compatible endpoint) ──
LLM_BASE_URL=<your-openai-compatible-url>/v1
LLM_API_KEY=sk-...
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# ── Embedding model (same as Step 2; first run downloads the ONNX model) ──
EMBED_MODEL=n24q02m/Qwen3-Embedding-0.6B-ONNX

# ── DeepEval LLM-judge (free-tier Groq) ──
GROQ_API_KEY=gsk_...

# ── Optional: LangSmith tracing ──
# LANGSMITH_API_KEY=ls_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=step3-langchain-rag
